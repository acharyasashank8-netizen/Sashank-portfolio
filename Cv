<!DOCTYPE html>  
<html lang="en">  
<head>  
  <meta charset="UTF-8">  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">  
  
  <title>Sashank Acharya | Personal Portfolio</title>  
  
  <style>  
    * {  
      margin: 0;  
      padding: 0;  
      box-sizing: border-box;  
      scroll-behavior: smooth;  
    }  
  
    body {  
      font-family: Arial, sans-serif;  
      background: #0b1120;  
      color: #f8fafc;  
      line-height: 1.6;  
    }  
  
    /* NAVBAR */  
    nav {  
      position: fixed;  
      top: 0;  
      width: 100%;  
      padding: 18px 8%;  
      background: rgba(11, 17, 32, 0.95);  
      display: flex;  
      justify-content: space-between;  
      align-items: center;  
      z-index: 1000;  
      border-bottom: 1px solid #1e293b;  
    }  
  
    .logo {  
      font-size: 24px;  
      font-weight: bold;  
    }  
  
    .logo span {  
      color: #38bdf8;  
    }  
  
    nav ul {  
      list-style: none;  
      display: flex;  
      gap: 25px;  
    }  
  
    nav a {  
      color: #cbd5e1;  
      text-decoration: none;  
      font-size: 15px;  
    }  
  
    nav a:hover {  
      color: #38bdf8;  
    }  
  
    /* GENERAL */  
    section {  
      padding: 100px 8%;  
    }  
  
    .container {  
      max-width: 1100px;  
      margin: auto;  
    }  
  
    .section-title {  
      text-align: center;  
      font-size: 34px;  
      margin-bottom: 50px;  
    }  
  
    .section-title span {  
      color: #38bdf8;  
    }  
  
    /* HOME */  
    #home {  
      min-height: 100vh;  
      display: flex;  
      align-items: center;  
      padding-top: 120px;  
    }  
  
    .hero {  
      display: flex;  
      justify-content: space-between;  
      align-items: center;  
      gap: 50px;  
      width: 100%;  
    }  
  
    .hero-text {  
      flex: 1;  
    }  
  
    .hero-text h1 {  
      font-size: 55px;  
      margin-bottom: 10px;  
    }  
  
    .hero-text h1 span {  
      color: #38bdf8;  
    }  
  
    .hero-text h2 {  
      font-size: 25px;  
      color: #94a3b8;  
      margin-bottom: 20px;  
    }  
  
    .hero-text p {  
      color: #cbd5e1;  
      max-width: 600px;  
      margin-bottom: 30px;  
    }  
  
    .location {  
      color: #94a3b8;  
      margin-bottom: 25px;  
    }  
  
    .btn {  
      display: inline-block;  
      padding: 13px 25px;  
      background: #38bdf8;  
      color: #07111f;  
      text-decoration: none;  
      border-radius: 8px;  
      font-weight: bold;  
      margin-right: 10px;  
    }  
  
    .btn:hover {  
      opacity: 0.85;  
    }  
  
    .btn-outline {  
      background: transparent;  
      color: #38bdf8;  
      border: 1px solid #38bdf8;  
    }  
  
    /* PHOTO */  
    .profile-photo {  
      width: 280px;  
      height: 280px;  
      border-radius: 50%;  
      border: 5px solid #38bdf8;  
      display: flex;  
      align-items: center;  
      justify-content: center;  
      color: #94a3b8;  
      text-align: center;  
      padding: 30px;  
      background: #111827;  
    }  
  
    /* ABOUT */  
    .about-box {  
      max-width: 850px;  
      margin: auto;  
      background: #111827;  
      padding: 35px;  
      border-radius: 15px;  
      border: 1px solid #1e293b;  
    }  
  
    .about-box p {  
      color: #cbd5e1;  
    }  
  
    /* EDUCATION */  
    .education-card {  
      max-width: 750px;  
      margin: auto;  
      background: #111827;  
      padding: 30px;  
      border-left: 4px solid #38bdf8;  
      border-radius: 10px;  
    }  
  
    .education-card h3 {  
      font-size: 24px;  
      margin-bottom: 8px;  
    }  
  
    .education-card h4 {  
      color: #38bdf8;  
      margin-bottom: 10px;  
    }  
  
    .education-card p {  
      color: #cbd5e1;  
    }  
  
    /* SKILLS */  
    .skills {  
      display: grid;  
      grid-template-columns: repeat(4, 1fr);  
      gap: 18px;  
    }  
  
    .skill {  
      background: #111827;  
      padding: 22px;  
      text-align: center;  
      border-radius: 10px;  
      border: 1px solid #1e293b;  
      transition: 0.3s;  
    }  
  
    .skill:hover {  
      transform: translateY(-5px);  
      border-color: #38bdf8;  
    }  
  
    .skill h3 {  
      font-size: 17px;  
    }  
  
    /* PROJECTS */  
    .projects {  
      display: grid;  
      grid-template-columns: repeat(2, 1fr);  
      gap: 25px;  
    }  
  
    .project {  
      background: #111827;  
      padding: 30px;  
      border-radius: 12px;  
      border: 1px solid #1e293b;  
    }  
  
    .project h3 {  
      color: #38bdf8;  
      margin-bottom: 12px;  
    }  
  
    .project p {  
      color: #cbd5e1;  
    }  
  
    /* CONTACT */  
    .contact-box {  
      max-width: 700px;  
      margin: auto;  
      text-align: center;  
      background: #111827;  
      padding: 35px;  
      border-radius: 15px;  
    }  
  
    .contact-item {  
      margin: 18px 0;  
      color: #cbd5e1;  
    }  
  
    .contact-item strong {  
      color: #38bdf8;  
    }  
  
    /* FOOTER */  
    footer {  
      text-align: center;  
      padding: 25px;  
      border-top: 1px solid #1e293b;  
      color: #94a3b8;  
    }  
  
    /* MOBILE */  
    @media (max-width: 800px) {  
  
      nav {  
        padding: 15px 5%;  
      }  
  
      nav ul {  
        gap: 12px;  
      }  
  
      nav a {  
        font-size: 12px;  
      }  
  
      section {  
        padding: 80px 5%;  
      }  
  
      .hero {  
        flex-direction: column-reverse;  
        text-align: center;  
      }  
  
      .hero-text h1 {  
        font-size: 40px;  
      }  
  
      .hero-text h2 {  
        font-size: 20px;  
      }  
  
      .profile-photo {  
        width: 220px;  
        height: 220px;  
      }  
  
      .skills {  
        grid-template-columns: repeat(2, 1fr);  
      }  
  
      .projects {  
        grid-template-columns: 1fr;  
      }  
  
      .section-title {  
        font-size: 28px;  
      }  
    }  
  
    @media (max-width: 450px) {  
  
      nav .logo {  
        font-size: 18px;  
      }  
  
      nav ul {  
        gap: 8px;  
      }  
  
      nav a {  
        font-size: 10px;  
      }  
  
      .skills {  
        grid-template-columns: 1fr;  
      }  
  
      .hero-text h1 {  
        font-size: 34px;  
      }  
  
      .btn {  
        display: block;  
        margin: 10px 0;  
      }  
    }  
  </style>  
</head>  
  
